title                   = NVT equilibration
integrator              = md
nsteps                  = 50000
dt                      = 0.002

nstxout-compressed      = 5000
nstenergy               = 5000
nstlog                  = 5000

continuation            = no
constraint_algorithm    = lincs
constraints             = h-bonds

cutoff-scheme           = Verlet
coulombtype             = PME
rcoulomb                = 1.0
rvdw                    = 1.0

tcoupl                  = V-rescale
tc-grps                 = Protein Non-Protein
tau_t                   = 0.1 0.1
ref_t                   = 300 300

pcoupl                  = no

pbc                     = xyz
